<Window
    x:Class="HTPCAVRVolume.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,0,4">
            <StackPanel x:Name="ContentPanel" Spacing="8" Padding="20,12,20,18">

                <!-- The level, and everything that changes it -->
                <Border x:Name="VolumeCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Padding="18,18,18,16">
                    <!-- A Border cannot be disabled, and this whole card has nothing to offer
                         until a receiver answers. -->
                    <ContentControl x:Name="VolumeCardBody" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="14">
                        <StackPanel x:Name="LevelBlock" Spacing="0">
                            <TextBlock Text="Volume" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,2"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Grid ColumnSpacing="10" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="LevelText" Grid.Column="0"
                                           Text="--" FontSize="46" FontWeight="SemiBold"
                                           LineHeight="50" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="LevelSubtext" Grid.Column="1"
                                           Text="" FontSize="12" Margin="0,0,0,9"
                                           VerticalAlignment="Bottom"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MaximumText" Grid.Column="2"
                                           Text="" FontSize="12" Margin="0,0,0,9"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="2">
                            <Grid.Resources>
                                <!-- The speaker in the Windows taskbar has no button around it
                                     until the pointer is over it. Clearing only the resting
                                     brushes leaves the pointer-over and pressed ones to the
                                     theme, which is the half worth copying. -->
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="MuteButton" Grid.Column="0" Width="36" Height="36" Padding="0"
                                    Click="OnToggleMute">
                                <FontIcon x:Name="MuteIcon" Glyph="&#xE995;" FontSize="16" />
                            </Button>

                            <Button x:Name="DownButton" Grid.Column="1" Width="36" Height="36" Padding="0"
                                    Click="OnStepDown" ToolTipService.ToolTip="Turn the volume down one step">
                                <FontIcon Glyph="&#xE738;" FontSize="16" />
                            </Button>

                            <Slider x:Name="VolumeSlider" Grid.Column="2" VerticalAlignment="Center"
                                    Margin="8,0,8,0" Minimum="0" Maximum="196" StepFrequency="1"
                                    IsThumbToolTipEnabled="False"
                                    ValueChanged="OnSliderChanged" />

                            <Button x:Name="UpButton" Grid.Column="3" Width="36" Height="36" Padding="0"
                                    Click="OnStepUp" ToolTipService.ToolTip="Turn the volume up one step">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    </ContentControl>
                </Border>

                <!-- Receiver -->
                <tk:SettingsExpander x:Name="ReceiverExpander"
                                     Header="Receiver"
                                     Description="Not configured"
                                     IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Brand" Description="Control protocol used to talk to the receiver">
                            <ComboBox x:Name="DeviceBox" MinWidth="160" SelectionChanged="OnDeviceChanged">
                                <ComboBoxItem Content="Denon / Marantz" Tag="DenonMarantz" />
                                <ComboBoxItem Content="StormAudio" Tag="StormAudio" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="IP address" Description="Receiver menu &#8250; Network &#8250; Information">
                            <TextBox x:Name="HostBox" MinWidth="160" LostFocus="OnHostChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Auto-reconnect"
                                         Description="Keep trying on its own when the receiver does not answer">
                            <ToggleSwitch x:Name="AutoReconnectSwitch" MinWidth="0" OnContent="" OffContent=""
                                          Toggled="OnAutoReconnectToggled" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="AttemptsCard" Header="Attempts"
                                         Description="How many tries before it gives up and waits for Reconnect">
                            <NumberBox x:Name="AttemptsBox" MinWidth="96"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1" Minimum="1" Maximum="20"
                                       ValueChanged="OnAttemptsChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="TimeoutCard" Header="Timeout"
                                         Description="Seconds one try waits for an answer">
                            <NumberBox x:Name="TimeoutBox" MinWidth="96"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="1" Minimum="1" Maximum="120"
                                       ValueChanged="OnTimeoutChanged" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- Audio endpoint -->
                <tk:SettingsExpander x:Name="AudioExpander"
                                     Header="Audio device"
                                     Description=""
                                     IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE995;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Keep audio device alive"
                                         Description="Holds a silent stream on the receiver so Windows stops powering its audio down between tracks, which is what causes the delay and the pop when sound starts again">
                            <ToggleSwitch x:Name="KeepAliveSwitch" MinWidth="0" OnContent="" OffContent=""
                                          Toggled="OnKeepAliveToggled" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="KeepAliveStatusCard" Header="State">
                            <TextBlock x:Name="KeepAliveStatus" Text="Off" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- Volume behaviour -->
                <tk:SettingsExpander x:Name="BehaviourExpander"
                                     Header="Volume behaviour"
                                     Description=""
                                     IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Power"
                                         Description="Switch a zone on or off on the receiver">
                            <StackPanel x:Name="PowerButtons" Orientation="Horizontal" Spacing="6" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Zone"
                                         Description="Which speakers the volume keys and the slider drive">
                            <ComboBox x:Name="ZoneBox" MinWidth="160" SelectionChanged="OnZoneChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="UnitCard" Header="Display unit"
                                         Description="Scale (0&#8211;98) or absolute decibels">
                            <ComboBox x:Name="UnitBox" MinWidth="120" SelectionChanged="OnUnitChanged">
                                <ComboBoxItem Content="dB" />
                                <ComboBoxItem Content="Scale" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Step size" Description="Change per key press, wheel detent or slider notch">
                            <NumberBox x:Name="StepBox" MinWidth="96"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="0.5" Minimum="0.5" Maximum="10"
                                       ValueChanged="OnStepSizeChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="MaximumCard" Header="Maximum volume"
                                         Description="The loudest the app will go, and the top of the slider">
                            <Grid>
                                <NumberBox x:Name="MaximumBox" MinWidth="96"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="0.5"
                                           ValueChanged="OnMaximumChanged" />
                                <!-- A zone has no free choice: its ceiling is the one set in the
                                     receiver's own Limit menu, which offers exactly these. -->
                                <ComboBox x:Name="MaximumChoice" MinWidth="96" Visibility="Collapsed"
                                          SelectionChanged="OnMaximumChoiceChanged">
                                    <ComboBoxItem Content="60" Tag="60" />
                                    <ComboBoxItem Content="70" Tag="70" />
                                    <ComboBoxItem Content="80" Tag="80" />
                                </ComboBox>
                            </Grid>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- On-screen display -->
                <tk:SettingsExpander x:Name="OverlayExpander"
                                     Header="On-screen display"
                                     Description=""
                                     IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Show volume overlay"
                                         Description="Large readout over full-screen video">
                            <ToggleSwitch x:Name="OverlaySwitch" MinWidth="0" OnContent="" OffContent="" Toggled="OnOverlayToggled" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Also when the AVR&#8217;s own remote is used"
                                         Description="Show it for changes you make on the receiver itself">
                            <ToggleSwitch x:Name="RemoteSwitch" MinWidth="0" OnContent="" OffContent="" Toggled="OnRemoteToggled" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- What the window's own buttons do -->
                <tk:SettingsExpander x:Name="WindowExpander"
                                     Header="Window buttons"
                                     Description=""
                                     IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE737;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Minimise button"
                                         Description="Volume control keeps running either way">
                            <ComboBox x:Name="MinimiseBox" MinWidth="200" SelectionChanged="OnMinimiseActionChanged">
                                <ComboBoxItem Content="Minimise the window" />
                                <ComboBoxItem Content="Send to the notification area" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="CloseActionCard" Header="Close button"
                                         Description="Quitting stops the volume keys and the overlay as well">
                            <ComboBox x:Name="CloseBox" MinWidth="200" SelectionChanged="OnCloseActionChanged">
                                <ComboBoxItem Content="Quit the app" />
                                <ComboBoxItem Content="Send to the notification area" />
                            </ComboBox>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

            </StackPanel>
        </ScrollViewer>

        <!-- Status and the one command that is not automatic -->
        <Border x:Name="Footer" Grid.Row="1"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting..." FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ReconnectButton" Grid.Column="2" Content="Reconnect"
                        Style="{StaticResource AccentButtonStyle}" Click="OnReconnect" />
            </Grid>
        </Border>
    </Grid>
</Window>
